    <worksheet name='top 10 cinemas'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#f1ce63' fontname='Tableau Bold' fontsize='10'>Top 10 cinemas</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Bookings+ (PVR_Movie_Booking_Tableau_Dataset)' name='federated.1kcj8f20dpa58q129o3490wqqwx0' />
          </datasources>
          <datasource-dependencies datasource='federated.1kcj8f20dpa58q129o3490wqqwx0'>
            <column caption='Booking Date' datatype='date' name='[Booking_Date]' role='dimension' type='ordinal' />
            <column caption='Cinema Name' datatype='string' name='[Cinema_Name]' role='dimension' type='nominal' />
            <column caption='Net Revenue INR' datatype='real' name='[Net_Revenue_INR]' role='measure' type='quantitative' />
            <column-instance column='[Booking_Date]' derivation='Month' name='[mn:Booking_Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Cinema_Name]' derivation='None' name='[none:Cinema_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Net_Revenue_INR]' derivation='Sum' name='[sum:Net_Revenue_INR:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1kcj8f20dpa58q129o3490wqqwx0].[Action (MONTH(Booking Date))]'>
            <groupfilter function='level-members' level='[mn:Booking_Date:ok]' user:ui-action-filter='[Action1_C0360C4545C24DE3B2242BF52DA50772]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1kcj8f20dpa58q129o3490wqqwx0].[none:Cinema_Name:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Net_Revenue_INR])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                  <groupfilter function='member' level='[none:Cinema_Name:nk]' member='&quot;PVR Aluva Cinemas&quot;' />
                  <groupfilter function='member' level='[none:Cinema_Name:nk]' member='&quot;PVR Andheri Mall&quot;' />
